# Supabase > Connect > Session pooler connection string
DATABASE_URL=
# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated list of Google accounts allowed into the admin
ADMIN_EMAILS=sergio.freitas@reaktor.com
# Public URL of the app. On Render, RENDER_EXTERNAL_URL is used if this is empty.
APP_URL=http://localhost:3000
